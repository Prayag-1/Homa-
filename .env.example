# Copy this file to .env for local development and fill in the values.
# Production hosting should use the Node.js app environment-variable panel.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example/homa
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
IMAGE_UPLOAD_MAX_MB=2
ESEWA_MERCHANT_ID=your-esewa-merchant-id
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=https://example.com/payment/success
ESEWA_FAILURE_URL=https://example.com/payment/failure
FONEPAY_MERCHANT_CODE=your-fonepay-merchant-code
FONEPAY_SECRET_KEY=your-fonepay-secret-key
FONEPAY_RETURN_URL=https://example.com/api/v1/orders/fonepay/return
HOMA_PAN=your-business-pan
HOMA_NAME=HOMA Beauty
HOMA_ADDRESS=Kathmandu, Nepal
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-email-user
EMAIL_PASS=your-email-password
EMAIL_FROM=HOMA Beauty <no-reply@example.com>
ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
DEFAULT_WHATSAPP_PHONE=9779800000000
