    "secrets": "node backend/src/scripts/generateSecrets.js",
    "ensure:indexes": "node backend/src/scripts/ensureIndexes.js",
    "create:admin": "node backend/src/scripts/createAdmin.js",
    "seed:products": "node backend/src/scripts/seedProducts.js",
    "seed:brands": "node backend/src/scripts/seedBrandsCategories.js",
    "migrate:smtp-settings": "node backend/src/scripts/migrateSmtpSettings.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.1",
    "@tanstack/react-query": "^5.5.0",
    "axios": "^1.5.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dompurify": "^3.4.10",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.0.0",
    "file-type": "^22.0.1",
    "framer-motion": "^10.16.4",
    "helmet": "^7.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.292.0",
    "mongoose": "^7.8.9",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-hook-form": "^7.47.0",
    "react-hot-toast": "^2.4.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.16.0",
    "recharts": "^3.8.1",
