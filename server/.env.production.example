NODE_ENV=production
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/homa
ALLOW_LOCAL_MONGO=true
JWT_SECRET=[run: node src/scripts/generateSecrets.js and paste first line]
JWT_REFRESH_SECRET=[paste second line from generateSecrets.js]
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PUBLIC_IMAGE_BASE_URL=https://api.homabeauty.com/api/v1/uploads
IMAGE_UPLOAD_MAX_MB=10
ESEWA_MERCHANT_ID=[live eSewa merchant ID]
ESEWA_SECRET_KEY=[live eSewa secret]
ESEWA_PAYMENT_URL=https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://epay.esewa.com.np/api/epay/transaction/status/
ESEWA_SUCCESS_URL=https://homabeauty.com/checkout/success
ESEWA_FAILURE_URL=https://homabeauty.com/checkout/failure
FONEPAY_MERCHANT_CODE=[live Fonepay merchant code]
FONEPAY_SECRET_KEY=[live Fonepay secret]
FONEPAY_RETURN_URL=https://homabeauty.com/checkout/success
HOMA_PAN=[business PAN number]
HOMA_NAME=HOMA Beauty Pvt. Ltd.
HOMA_ADDRESS=Kathmandu, Nepal
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=[Gmail address for sending]
EMAIL_PASS=[Gmail App Password - NOT regular Gmail password]
ADMIN_EMAIL=[email where contact inquiries are sent]
INITIAL_ADMIN_EMAIL=[first admin email]
INITIAL_ADMIN_PASSWORD=[temporary strong first admin password]
CLIENT_URL=https://homabeauty.com
DEFAULT_WHATSAPP_PHONE=9707082505
